# Docker Compose runtime (single source of truth).
# Copy to .env with `make devsetup`.
COMPOSE_FILE=docker-compose/docker-compose.yaml
COMPOSE_PROJECT_NAME=contract-management
SPRING_PROFILES_ACTIVE=local

# Ports
APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Infrastructure credentials (local only — never reuse these anywhere real)
POSTGRES_USER=contract_management
POSTGRES_PASSWORD=contract_management
POSTGRES_DB=contract_management

# Application datasource. Points at the `db` service above.
DATASOURCE_URL=jdbc:postgresql://localhost:5432/contract_management
DATASOURCE_USERNAME=contract_management
DATASOURCE_PASSWORD=contract_management

# Test datasource. Points at the `test_db` service above. The integration tests skip
# themselves when this is unreachable (test.definition.md § 1.3).
TEST_DATASOURCE_URL=jdbc:postgresql://localhost:5433/contract_management_test
TEST_DATASOURCE_USERNAME=contract_management
TEST_DATASOURCE_PASSWORD=contract_management
