### UC05 – Start Tour (happy path, startedAt from clock)
# Prerequisite: a GuideTour must exist in SCHEDULED state with scheduledStart <= now.
# No request body required; the server uses the current clock time.
POST http://localhost:8080/api/v1/guide-tours/{{guideTourId}}/start

### UC05 – Start Tour (happy path, explicit startedAt)
# Prerequisite: a GuideTour must exist in SCHEDULED state and startedAt >= scheduledStart.
POST http://localhost:8080/api/v1/guide-tours/{{guideTourId}}/start
Content-Type: application/json

{
  "startedAt": "2026-06-15T09:05:00Z"
}

### UC05 – Error: guide tour not found (404)
# A random UUID that does not exist in the system.
POST http://localhost:8080/api/v1/guide-tours/00000000-0000-0000-0000-000000000000/start

### UC05 – Error: invalid state (409)
# Prerequisite: the guide tour has already been started (status = RUNNING).
# Attempting to start an already-running tour triggers InvalidGuideTourStateException.
POST http://localhost:8080/api/v1/guide-tours/{{guideTourId}}/start

### UC05 – Error: too early (409)
# The provided startedAt is before the tour's scheduledStart.
# Triggers TourStartTooEarlyException.
POST http://localhost:8080/api/v1/guide-tours/{{guideTourId}}/start
Content-Type: application/json

{
  "startedAt": "2026-06-15T07:00:00Z"
}
